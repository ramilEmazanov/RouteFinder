{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "default_agent": "build",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:AI_API_KEY}"
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "doom_loop": "deny"
  }
}
